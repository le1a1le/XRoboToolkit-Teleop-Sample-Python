<?xml version="1.0" ?>
<mujoco model="dual_RM75 scene">
  <!-- Include the robot model -->
  <include file="realman_dual_rm75.xml"/>

  <!-- Scene statistics for camera view -->
  <statistic center="0.3 0 0.8" extent="1.2" meansize="0.1"/>

  <!-- Visual settings -->
  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.1 0.1 0.1" specular="0 0 0"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <!-- Assets for scene elements -->
  <asset>
    <texture name="grid" type="2d" builtin="checker" rgb1=".2 .3 .4" rgb2=".1 0.15 0.2" width="512" height="512"
      mark="cross" markrgb=".8 .8 .8"/>
    <material name="grid" texture="grid" texrepeat="1 1" texuniform="true"/>
  </asset>

  <worldbody>
    <!-- Scene lighting -->
    <light pos="0 0 1.5" directional="true"/>
    
    <!-- Floor plane -->
    <geom name="floor" size="1.5 1.5 0.01" type="plane" material="grid"/>
    
    <!-- Right target: mocap body for visualizing right arm teleop target -->
    <body name="right_target" pos="0.4145 0.4101 0.7597" quat="0.2797 0.1481 -0.9050 -0.2843" mocap="true">
      <geom name="right_target_x_shaft" type="cylinder" size="0.005 0.05" pos="0.05 0 0" zaxis="1 0 0" rgba="1 0 0 1" contype="0" conaffinity="0" group="1"/>
      <geom name="right_target_y_shaft" type="cylinder" size="0.005 0.05" pos="0 0.05 0" zaxis="0 1 0" rgba="0 1 0 1" contype="0" conaffinity="0" group="1"/>
      <geom name="right_target_z_shaft" type="cylinder" size="0.005 0.05" pos="0 0 0.05" zaxis="0 0 1" rgba="0 0 1 1" contype="0" conaffinity="0" group="1"/>
      <site type="sphere" size="0.01" rgba="0 0 1 1" group="1"/>
    </body>
    
    <!-- Left target: mocap body for visualizing left arm teleop target -->
    <body name="left_target" pos="-0.5083 0.3923 0.6192" quat="0.0632 -0.8820 -0.4590 -0.0861" mocap="true">
      <geom name="left_target_x_shaft" type="cylinder" size="0.005 0.05" pos="0.05 0 0" zaxis="1 0 0" rgba="1 0 0 1" contype="0" conaffinity="0" group="1"/>
      <geom name="left_target_y_shaft" type="cylinder" size="0.005 0.05" pos="0 0.05 0" zaxis="0 1 0" rgba="0 1 0 1" contype="0" conaffinity="0" group="1"/>
      <geom name="left_target_z_shaft" type="cylinder" size="0.005 0.05" pos="0 0 0.05" zaxis="0 0 1" rgba="0 0 1 1" contype="0" conaffinity="0" group="1"/>
      <site type="sphere" size="0.01" rgba="0 0 1 1" group="1"/>
    </body>
    
    <!-- World coordinate frame reference (optional) -->
    <!-- X-axis arrow shaft -->
    <geom name="world_x_shaft" type="cylinder" size="0.01 0.1" pos="0.1 0 0.0" zaxis="1 0 0" rgba="1 0 0 1" contype="0" conaffinity="0" group="1"/>
    <!-- Y-axis arrow shaft -->
    <geom name="world_y_shaft" type="cylinder" size="0.01 0.1" pos="0 0.1 0.0" zaxis="0 1 0" rgba="0 1 0 1" contype="0" conaffinity="0" group="1"/>
    <!-- Z-axis arrow shaft -->
    <geom name="world_z_shaft" type="cylinder" size="0.01 0.2" pos="0 0 0.2" zaxis="0 0 1" rgba="0 0 1 1" contype="0" conaffinity="0" group="1"/>
  </worldbody>
</mujoco>