<mujoco model="ur5e scene">
  <include file="dual_ur5e.xml"/>

  <statistic center="0.3 0 0.3" extent="0.8" meansize="0.08"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.1 0.1 0.1" specular="0 0 0"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <asset>
    <texture name="grid" type="2d" builtin="checker" rgb1=".2 .3 .4" rgb2=".1 0.15 0.2" width="512" height="512"
      mark="cross" markrgb=".8 .8 .8"/>
    <material name="grid" texture="grid" texrepeat="1 1" texuniform="true"/>

   <!-- Peg assets -->
    <mesh file="/home/zz/mujoco_RL_file/robosuite/pico_vr/XRoboToolkit-Teleop-Sample-Python/assets/universal_robots_ur5e/object_scene/yuanzhu.STL" name="yuanzhu_mesh" scale="0.002 0.002 0.002"/>
    <texture file="/home/zz/mujoco_RL_file/robosuite/pico_vr/XRoboToolkit-Teleop-Sample-Python/assets/universal_robots_ur5e/object_scene/red-wood.png" name="red-wood"/>
    <material name="peg_material" reflectance="1.0" shininess="1.0" specular="1.0" texrepeat="1 1" texture="red-wood" texuniform="true"/>

    <!-- Hole assets -->
    <mesh file="/home/zz/mujoco_RL_file/robosuite/pico_vr/XRoboToolkit-Teleop-Sample-Python/assets/universal_robots_ur5e/object_scene/yuanzhukong.STL" name="yuanzhukong_mesh" scale="0.002 0.002 0.002"/>
    <texture file="/home/zz/mujoco_RL_file/robosuite/pico_vr/XRoboToolkit-Teleop-Sample-Python/assets/universal_robots_ur5e/object_scene/blue-wood.png" name="blue-wood"/>
    <material name="hole_material" reflectance="1.0" shininess="1.0" specular="1.0" texrepeat="1 1" texture="blue-wood" texuniform="true"/>

   
  </asset>

  <worldbody>
    <light pos="0 0 1.5" directional="true"/>
    <geom name="floor" size="1 1 0.01" type="plane" material="grid" contype="1" conaffinity="1" group="0"/>

    <!-- Peg object on table (桌面上的圆柱体) -->
    <!-- 桌面高度: 0.775 + 0.025 = 0.8, peg 底部在 -0.082, 所以 peg body 应该在 0.8 + 0.082 = 0.882 -->
    <body name="peg" pos="0.5  0.2 0.9" quat= " 0 0 0 1">
      <freejoint/>
      <geom name="peg_col" type="cylinder" size="0.004 0.03" density="800"  friction="1 0.005 0.0001" solref="0.01 1" solimp="0.9 0.95 0.001" condim="3" contype="1" conaffinity="65535"/>
      <geom name="peg_vis" type="mesh" mesh="yuanzhu_mesh" material="peg_material" contype="0" conaffinity="0"/>
      <site rgba="0 0 0 0" size="0.005" pos="0 0 -0.03" name="peg_bottom_site"/>

    </body>

    <!-- Hole object on table (桌面上的圆柱孔) -->
    <body name="hole" pos="0.5  -0.2 0.9">
      <freejoint/>
      <geom name="hole_col" type="cylinder" size="0.0043 0.03" density="1000"  friction="1 0.005 0.0001" solref="0.01 1" solimp="0.9 0.95 0.001" condim="3" contype="1" conaffinity="65535"/>
      <geom name="hole_vis" type="mesh" mesh="yuanzhukong_mesh" material="hole_material" contype="0" conaffinity="0"/>


      <site rgba="0 0 0 0" size="0.005" pos="0 0 0.03" name="hole_top_site"/>
     
    </body>

    <body name="right_target" pos=" 0  0 0" quat="1  0 0 0" mocap="true">
      <!-- X-axis arrow shaft -->
      <geom name="right_target_x_shaft" type="cylinder" size="0.005 0.05" pos="0.05 0 0" zaxis="1 0 0" rgba="1 0 0 1" contype="0" conaffinity="0" group="1"/>
      <!-- Y-axis arrow shaft -->
      <geom name="right_target_y_shaft" type="cylinder" size="0.005 0.05" pos="0 0.05 0" zaxis="0 1 0" rgba="0 1 0 1" contype="0" conaffinity="0" group="1"/>
      <!-- Z-axis arrow shaft -->
      <geom name="right_target_z_shaft" type="cylinder" size="0.005 0.05" pos="0 0 0.05" zaxis="0 0 1" rgba="0 0 1 1" contype="0" conaffinity="0" group="1"/>
      <site type="sphere" size="0.01" rgba="0 0 1 1" group="1"/>
    </body>
    <body name="left_target" pos=" 0 0 0 " quat="1 0 0 0" mocap="true">
      <!-- X-axis arrow shaft -->
      <geom name="left_target_x_shaft" type="cylinder" size="0.005 0.05" pos="0.05 0 0" zaxis="1 0 0" rgba="1 0 0 1" contype="0" conaffinity="0" group="1"/>
      <!-- Y-axis arrow shaft -->
      <geom name="left_target_y_shaft" type="cylinder" size="0.005 0.05" pos="0 0.05 0" zaxis="0 1 0" rgba="0 1 0 1" contype="0" conaffinity="0" group="1"/>
      <!-- Z-axis arrow shaft -->
      <geom name="left_target_z_shaft" type="cylinder" size="0.005 0.05" pos="0 0 0.05" zaxis="0 0 1" rgba="0 0 1 1" contype="0" conaffinity="0" group="1"/>
      <site type="sphere" size="0.01" rgba="0 0 1 1" group="1"/>
    </body>
    <!-- X-axis arrow shaft -->
    <geom name="world_x_shaft" type="cylinder" size="0.01 0.1" pos="0.1 0 0.0" zaxis="1 0 0" rgba="1 0 0 1" contype="0" conaffinity="0" group="1"/>
    <!-- Y-axis arrow shaft -->
    <geom name="world_y_shaft" type="cylinder" size="0.01 0.1" pos="0 0.1 0.0" zaxis="0 1 0" rgba="0 1 0 1" contype="0" conaffinity="0" group="1"/>
    <!-- Z-axis arrow shaft -->
    <geom name="world_z_shaft" type="cylinder" size="0.01 0.2" pos="0 0 0.2" zaxis="0 0 1" rgba="0 0 1 1" contype="0" conaffinity="0" group="1"/>
  </worldbody>
</mujoco>
